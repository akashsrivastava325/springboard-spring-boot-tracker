rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/notebooks/main {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validNotebook() {
        let data = request.resource.data;
        return data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
          && data.payload is string && data.payload.size() <= 900000
          && data.revision is int && data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && validNotebook() && request.resource.data.revision == 1;
      allow update: if owner() && validNotebook()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner();
    }
  }
}
